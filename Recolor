-- WATCH GUN DISPLAY & WORKSPACE BEAMS/TRAILS

workspace.DescendantAdded:Connect(function(object)
    if object.Name == "GunDisplay" then
        task.wait(0.2)
        applyScope()

    elseif object:IsA("Beam") or object:IsA("Trail") then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if char and object:IsDescendantOf(char) then
            applyBeamAndTrailToObject(
                object,
                selectedDesign and DESIGNS[selectedDesign]
            )

        elseif hrp then
            local pos = getObjectPosition(object)

            if pos and (pos - hrp.Position).Magnitude <= 35 then
                applyBeamAndTrailToObject(
                    object,
                    selectedDesign and DESIGNS[selectedDesign]
                )
            end
        end
    end
end)

