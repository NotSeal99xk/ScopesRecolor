-- RESPUALDO DE TEXTURAS ORIGINALES (BEAM & TRAIL)

local originalEffectTextures = setmetatable({}, { __mode = "k" })

local function cacheOriginalTexture(effect)
if originalEffectTextures[effect] == nil then
originalEffectTextures[effect] = effect.Texture
end
end

-- TEXTURE SYSTEM (MESH / DECAL / TEXTURE)

local function updateTextures(root)
local design = DESIGNS[selectedDesign]
if not design or not root then return end

local texture = design.Texture  

local function update(object)  
    if object:IsA("MeshPart") then  
        object.TextureID = texture  
    elseif object:IsA("SpecialMesh") then  
        object.TextureId = texture  
    elseif object:IsA("Decal") or object:IsA("Texture") then  
        object.Texture = texture  
    end  
end  

update(root)  

for _, object in ipairs(root:GetDescendants()) do  
    update(object)  
end

end

-- BEAM AND TRAIL SYSTEM

local function applyBeamAndTrailToObject(object, design)
if not design or not object then return end

if object:IsA("Beam") then  
    cacheOriginalTexture(object)  

    if design.Color then  
        object.Color = ColorSequence.new(design.Color)  
    end  

    if type(design.BeamTexture) == "string" and design.BeamTexture ~= "" then  
        object.Texture = design.BeamTexture  
    elseif originalEffectTextures[object] ~= nil then  
        object.Texture = originalEffectTextures[object]  
    end  

elseif object:IsA("Trail") then  
    cacheOriginalTexture(object)  

    if design.Color then  
        object.Color = ColorSequence.new(design.Color)  
    end  

    if type(design.TrailTexture) == "string" and design.TrailTexture ~= "" then  
        object.Texture = design.TrailTexture  
    elseif originalEffectTextures[object] ~= nil then  
        object.Texture = originalEffectTextures[object]  
    end  
end

end

local function applyBeamColor(root)
local design = DESIGNS[selectedDesign]
if not design or not root then return end

applyBeamAndTrailToObject(root, design)  

for _, object in ipairs(root:GetDescendants()) do  
    applyBeamAndTrailToObject(object, design)  
end

end

-- GUN DISPLAY

local function getObjectPosition(object)
if object:IsA("BasePart") then
return object.Position
elseif object:IsA("Model") then
return object:GetPivot().Position
end

local part = object:FindFirstChildWhichIsA("BasePart", true)  
return part and part.Position

end

local function findNearestGunDisplay()
local character = player.Character
local root = character and character:FindFirstChild("HumanoidRootPart")

if not root then return nil end  

local nearest  
local nearestDistance = math.huge  

for _, object in ipairs(workspace:GetDescendants()) do  
    if object.Name == "GunDisplay" then  
        local position = getObjectPosition(object)  

        if position then  
            local distance = (position - root.Position).Magnitude  

            if distance < nearestDistance then  
                nearest = object  
                nearestDistance = distance  
            end  
        end  
    end  
end  

return nearest

end

local function applyScope()
local display = findNearestGunDisplay()

if display then  
    updateTextures(display)  
    applyBeamColor(display)  
end

end

-- GUN TOOL & CHARACTER

local function applyGunEffects()
local character = player.Character
local backpack = player:FindFirstChildOfClass("Backpack")

if character then  
    applyBeamColor(character)  
end  

for _, container in ipairs({character, backpack}) do  
    if container then  
        for _, tool in ipairs(container:GetChildren()) do  
            if tool:IsA("Tool") and tool.Name == "Gun" then  
                updateTextures(tool)  
                applyBeamColor(tool)  
            end  
        end  
    end  
end

end

local function applyAll()
applyScope()
applyGunEffects()
end

